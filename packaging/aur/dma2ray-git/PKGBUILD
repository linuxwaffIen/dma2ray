# PKGBUILD для AUR: dma2ray-git
#
# Клиент VLESS Dma2ray, компилируемый в единый бинарник (Nuitka) прямо
# на машине пользователя — поэтому пакет собирается под любую архитектуру
# из arch=() (x86_64, aarch64, armv7h).
#
# Сборка и установка у пользователя (yay/paru или вручную):
#   makepkg -si
#
# Публикация в AUR:
#   git clone ssh://aur@aur.archlinux.org/dma2ray-git.git
#   cp PKGBUILD .SRCINFO <клонированный-каталог>/
#   cd <клонированный-каталог> && git add PKGBUILD .SRCINFO
#   git commit -m "dma2ray-git: 0.2.0" && git push
# (.SRCINFO перегенерировать: makepkg --printsrcinfo > .SRCINFO)
pkgname=dma2ray-git
pkgver=0.2.0
pkgrel=1
pkgdesc="GTK4/Adwaita-клиент VLESS (Xray): три режима подключения"
arch=('x86_64' 'aarch64' 'armv7h')
url="https://github.com/linuxwaffIen/dma2ray"
license=('GPL-3.0-only')
depends=('python>=3.10' 'python-gobject' 'gtk4' 'libadwaita' 'polkit' 'xdg-utils' 'hicolor-icon-theme')
# nuitka — компилятор из AUR (не в makedepends, чтобы не было циклической
# зависимости при установке через makepkg -s): ./build.sh найдёт системный
# nuitka или поставит его через pip в .build/venv при первой сборке.
# patchelf — обязателен для standalone-режима Nuitka.
# python-pip — запасной путь установки nuitka, если системного нет.
makedepends=('git' 'patchelf' 'python-pip')
optdepends=(
    'gtk3: иконка в системном трее'
    'libayatana-appindicator: поддержка AppIndicator для трея'
)
provides=('dma2ray')
# Nuitka-бинарник уже урезан (strip не нужен и может вызвать предупреждения).
options=(!strip)
source=("$pkgname::git+$url")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    # Версия: последний git-тег (без v) либо VERSION из исходников,
    # плюс количество коммитов и короткий хэш.
    local ver tag
    tag=$(git describe --tags --abbrev=0 2>/dev/null | sed 's/^[vV]//')
    if [ -n "$tag" ]; then
        ver=$tag
    else
        ver=$(sed -n 's/^VERSION = "\([^"]*\)"/\1/p' dma2ray/paths.py 2>/dev/null)
    fi
    printf '%s.r%s.g%s' "${ver:-0}" \
        "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    cd "$pkgname"
    # Компиляция в dist/dma2ray.dist/dma2ray под архитектуру машины.
    # build.sh сам поднимет окружение (.build/venv) и вызовет nuitka.
    ./build.sh
}

package() {
    cd "$pkgname"

    install -d "$pkgdir/usr/lib/dma2ray" \
               "$pkgdir/usr/bin" \
               "$pkgdir/usr/share/applications" \
               "$pkgdir/usr/share/icons/hicolor/scalable/apps"

    # Исходники (helper-скрипты, тесты) и данные.
    cp -a dma2ray data "$pkgdir/usr/lib/dma2ray/"
    install -m644 LICENSE README.md "$pkgdir/usr/lib/dma2ray/"
    # Скомпилированный бинарник с библиотеками, helper-скриптами и данными.
    cp -a dist/dma2ray.dist "$pkgdir/usr/lib/dma2ray/app"
    ln -s ../lib/dma2ray/app/dma2ray "$pkgdir/usr/bin/dma2ray"

    find "$pkgdir/usr/lib/dma2ray" -type d -name __pycache__ -prune -exec rm -rf {} +
    find "$pkgdir/usr/lib/dma2ray" -type f -name '*.pyc' -delete

    install -m644 data/io.github.dma2ray.Dma2ray.desktop \
        "$pkgdir/usr/share/applications/"
    install -m644 data/io.github.dma2ray.Dma2ray.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
}
